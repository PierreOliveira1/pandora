{
	"name": "pandora-ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4",
		"@sveltejs/kit": "^3",
		"@sveltejs/vite-plugin-svelte": "^7",
		"@tailwindcss/vite": "^4",
		"@vitest/browser-playwright": "^4",
		"playwright": "^1",
		"prettier": "^3",
		"prettier-plugin-svelte": "^4",
		"prettier-plugin-tailwindcss": "^0.8",
		"svelte": "^5",
		"svelte-check": "^4",
		"tailwindcss": "^4",
		"typescript": "^6",
		"vite": "^8",
		"vitest": "^4"
	}
}
